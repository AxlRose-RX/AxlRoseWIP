<!--  only mess with FFNx driver settings for gamepad icons if my UI is
      enabled (UI_ID="1") otherwise don't  touch driver settings 
      
      internal_resolution_scale = 4
      "This is required to avoid visual glitches that may happen
      when the game is not rendered in a 4:3 aspect ratio." - This is very true,
      if we don't set internal_resolution_scale to 4 minimum, the upscaled 4x textures
      will glitch, ex. bcgate_1 at 16:9 with internal_resolution_scale = 0
      
      enable_bilinear = true
      Recommended by TrueOdin and myst6re, I don't see any difference with it enabled tbh.
-->
  <FFNxConfig>
    <ff8_use_gamepad_icons UI_Controller_ID="0" UI_ID="1">false</ff8_use_gamepad_icons>
    <ff8_use_gamepad_icons UI_Controller_ID="1" UI_ID="1">true</ff8_use_gamepad_icons>
    <ff8_use_gamepad_icons UI_Controller_ID="2" UI_ID="1">true</ff8_use_gamepad_icons>
    
    <internal_resolution_scale FIELDSA_ID="1">4</internal_resolution_scale>
    <internal_resolution_scale FIELDS4X_ID="1">4</internal_resolution_scale>
    <enable_bilinear FIELDSA_ID="1">true</enable_bilinear>
    <enable_bilinear FIELDS4X_ID="1">true</enable_bilinear>
  </FFNxConfig>

</ModInfo>